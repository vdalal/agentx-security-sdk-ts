    "url": "git+https://github.com/vdalal/agentx-security-sdk-ts.git"
  },
  "bugs": {
    "email": "founders@agentx-core.com"
  },
  "keywords": [
    "ai",
    "agent",
    "agents",
    "ai-agent",
    "tools",
    "tool-calling",
    "security",
    "audit",
    "observability",
    "vercel-ai-sdk",
    "llm",
    "typescript"
  ],
  "bin": {
